# Read-only Bybit mainnet key. Never paste keys into the browser.
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_MONITOR_API_KEY=
BYBIT_MONITOR_API_SECRET=
# standard: Bybit VIP 0 linear taker rate (0.055%) for simulation.
# account: prefer the private read-only /v5/account/fee-rate endpoint.
BYBIT_FEE_MODE=standard
BYBIT_HTTP_URL=https://api.bybit.com
BYBIT_WS_URL=wss://stream.bybit.com/v5/public/linear
DATABASE_PATH=data/crypto.sqlite3
# Minimum quote turnover on a breakout candle. Scales with timeframe length.
BREAKOUT_MIN_NOTIONAL_USDT_PER_5M=10000
# Maximum live orderbook spread for a virtual entry candidate, in basis points.
MAX_ENTRY_SPREAD_BPS=15
